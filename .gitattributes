# =========================================================
# GitHub Linguist — project language policy
# Counted:
# Svelte / Zig / JavaScript / Vue / Go / TypeScript / Elixir
# =========================================================

# ---------------------------------------------------------
# Force language detection
# ---------------------------------------------------------

*.svelte linguist-language=Svelte
*.zig linguist-language=Zig
*.js linguist-language=JavaScript
*.vue linguist-language=Vue
*.go linguist-language=Go
*.ts linguist-language=TypeScript
*.ex linguist-language=Elixir
*.exs linguist-language=Elixir

# ---------------------------------------------------------
# Include normally ignored directories
# ---------------------------------------------------------

# Docs
docs/*.md.js linguist-language=JavaScript
docs/*.md.js linguist-detectable=true
docs/*.md.js linguist-documentation=false
examples/plugins/*.js linguist-language=JavaScript
examples/plugins/*.js linguist-detectable=true
examples/plugins/*.js linguist-vendored=false

# Frontend dist output
apps/explorer/frontend/dist/** linguist-detectable=true
apps/explorer/frontend/dist/** linguist-vendored=false
apps/settings/frontend/dist/** linguist-detectable=true
apps/settings/frontend/dist/** linguist-vendored=false

# ---------------------------------------------------------
# Exclude ONLY build artifacts
# ---------------------------------------------------------

# Wails build output
apps/explorer/build/** linguist-vendored=true

# Frontend dist output
apps/explorer/frontend/wailsjs/runtime/** linguist-vendored=true

# Svelte build cache
.svelte-kit/** linguist-vendored=true

# Zig build/cache
zig-cache/** linguist-vendored=true
zig-out/** linguist-vendored=true

# Node modules
node_modules/** linguist-vendored=true

# Coverage
coverage/** linguist-vendored=true